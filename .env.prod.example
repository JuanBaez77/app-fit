# Copiá este archivo a .env en el servidor (/opt/production/app-fit/.env) y completalo.
# Nunca lo subas al repo.

# Base de datos
POSTGRES_USER=appfit
POSTGRES_DB=appfit
# openssl rand -base64 24
POSTGRES_PASSWORD=

# Firma de los tokens de acceso. openssl rand -base64 48
JWT_SECRET=

# Puerto en 127.0.0.1 al que apunta el nginx del host
APP_PORT=8020

# Workers de gunicorn
WEB_WORKERS=2

# Días que se guardan las copias de backups/
BACKUP_KEEP_DAYS=14

# Análisis del brain. Sin key, "Analizar" responde que falta configurarla.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5-5
