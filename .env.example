# Copiá este archivo a .env para cambiar los valores de desarrollo.
# docker-compose.yml ya trae estos mismos valores por defecto, así que .env es opcional en dev.

POSTGRES_USER=appfit
POSTGRES_PASSWORD=appfit
POSTGRES_DB=appfit

# Puertos expuestos en tu máquina
DB_PORT=5432
API_PORT=8000
NGINX_PORT=8080

# Usuario de desarrollo (make dev-user). Solo para la base local.
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=contrasena-dev-123

# Producción: obligatorio y largo (al menos 32 bytes). En dev hay uno por defecto.
# JWT_SECRET=
